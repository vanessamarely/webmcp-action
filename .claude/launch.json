{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webmcp-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
